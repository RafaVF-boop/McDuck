# Formato de los Secrets de Streamlit Community Cloud
# (App settings > Secrets). Copia este contenido allí con tus claves reales.
# Para pruebas locales también puedes guardarlo como .streamlit/secrets.toml
# (ese archivo está en .gitignore).

GROQ_API_KEY = "tu_clave_de_groq"
ALPHA_VANTAGE_API_KEY = "tu_clave_de_alpha_vantage"
SUPABASE_URL = "https://xxxxxxxx.supabase.co"
SUPABASE_KEY = "tu_clave_service_role"

# Recomendado si la app es pública:
APP_PASSWORD = "una_contraseña"
